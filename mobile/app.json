{
  "expo": {
    "name": "Servix",
    "slug": "servix",
    "scheme": "servix",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563EB"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.servix.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Servix precisa da sua localização para encontrar prestadores próximos.",
        "NSLocationAlwaysUsageDescription": "Servix precisa da sua localização para notificar sobre serviços próximos.",
        "NSCameraUsageDescription": "Servix precisa da câmera para enviar fotos dos serviços.",
        "NSPhotoLibraryUsageDescription": "Servix precisa acessar suas fotos para enviar imagens dos serviços."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2563EB"
      },
      "package": "com.servix.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Servix precisa da sua localização."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2563EB"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Servix precisa acessar suas fotos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
